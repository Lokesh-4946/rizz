{
  "schema_version": 2,
  "id": "pi-bench-review-generated-artifact-precision",
  "suite": "pi-bench-seed",
  "mode": "local",
  "category": "review-blast-radius",
  "title": "Generated artifact review precision benchmark seed",
  "prompt": "Review generated source churn and verify that Rizz keeps the changed artifact visible without treating it as authored runtime, architecture, flow, or state/data blast radius.",
  "fixture": {
    "root": "pi-bench-review-generated-artifact-precision",
    "files": [
      {
        "path": "package.json",
        "contents": "{\"name\":\"pi-bench-review-generated-artifact-precision\",\"scripts\":{\"test\":\"vitest run\",\"generate\":\"node scripts/generate-client.js\"},\"dependencies\":{\"express\":\"^4.19.0\"},\"devDependencies\":{\"vitest\":\"^2.0.0\",\"typescript\":\"^5.0.0\"}}\n"
      },
      {
        "path": "src/server.ts",
        "contents": "import express from \"express\";\nimport { profileHandler } from \"./routes/profile.js\";\n\nconst app = express();\napp.get(\"/profile\", profileHandler);\nexport { app };\n"
      },
      {
        "path": "src/routes/profile.ts",
        "contents": "import { getProfileClient } from \"../generated/profile-client.js\";\n\nexport async function profileHandler(_req: unknown, res: { json: (value: unknown) => void }) {\n  res.json(getProfileClient());\n}\n"
      },
      {
        "path": "src/generated/profile-client.ts",
        "contents": "export function getProfileClient() {\n  return { status: \"ready\" };\n}\n"
      },
      {
        "path": "vendor/sdk.ts",
        "contents": "export function vendorSdk() {\n  return \"1.0.0\";\n}\n"
      },
      {
        "path": "src/routes/profile.test.ts",
        "contents": "import { it } from \"vitest\";\n\nit(\"profiles\", () => {});\n"
      }
    ]
  },
  "review": {
    "diff": {
      "files": [
        {
          "path": "src/generated/profile-client.ts",
          "contents": "export function getProfileClient() {\n  return { status: \"ready\", schemaVersion: 2 };\n}\n"
        },
        {
          "path": "vendor/sdk.ts",
          "contents": "export function vendorSdk() {\n  return \"1.0.1\";\n}\n"
        }
      ]
    },
    "assertions": {
      "changed_files_include": ["src/generated/profile-client.ts", "vendor/sdk.ts"],
      "maximum_direct_components": 0,
      "maximum_affected_services": 0,
      "maximum_affected_flows": 0,
      "maximum_dependency_runtime_impacts": 0,
      "maximum_architecture_impact_surfaces": 0,
      "maximum_affected_data_dependencies": 0,
      "maximum_affected_state_operations": 0,
      "maximum_user_visible_failure_modes": 0,
      "findings_include": [
        {
          "category": "Maintainability",
          "title_includes": "Generated or vendor artifacts changed"
        }
      ],
      "findings_exclude": [
        { "category": "Missing tests", "title_includes": "Runtime files changed" },
        { "category": "Hidden coupling", "title_includes": "State/data dependency overlaps" },
        { "category": "Architecture drift", "title_includes": "Architecture impact map overlaps" }
      ],
      "forbidden_output_substrings": [
        "Runtime files changed without test artifacts",
        "State/data dependency overlaps the diff",
        "Architecture impact map overlaps the diff",
        "persisted state correctly"
      ]
    }
  },
  "expected_artifacts": [
    ".rizz/research/review_eval.json",
    ".rizz/research/review_claim_evidence.json",
    ".rizz/reports/review.html"
  ],
  "artifact_assertions": [
    {
      "path": ".rizz/research/review_eval.json",
      "type": "json",
      "required_fields": [
        "generated_artifact_count",
        "affected_flow_count",
        "affected_data_dependency_count",
        "affected_state_operation_count",
        "architecture_impact_surface_count",
        "secret_safety.output_secret_safe"
