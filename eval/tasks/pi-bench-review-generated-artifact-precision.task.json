      "expected_json_values": {
        "generated_artifact_count": 2,
        "affected_flow_count": 0,
        "affected_data_dependency_count": 0,
        "affected_state_operation_count": 0,
        "architecture_impact_surface_count": 0,
        "secret_safety.output_secret_safe": true
