    {
      "path": ".rizz/reports/review.html",
      "type": "file",
      "required_substrings": [
        "Generated or vendor artifacts changed",
        "src/generated/profile-client.ts",
        "vendor/sdk.ts"
      ],
      "forbidden_substrings": [
        "Runtime files changed without test artifacts",
        "State/data dependency overlaps the diff"
      ]
    }
  ],
  "rubric": {
    "pass": [
      "Generated and vendored source churn stays visible in review output.",
      "Generated and vendored churn does not create authored runtime, flow, architecture, or state/data blast radius."
    ],
    "fail": [
      "Generated source churn is reported as runtime source without tests.",
      "Vendored source churn creates flow, architecture, or state/data findings."
